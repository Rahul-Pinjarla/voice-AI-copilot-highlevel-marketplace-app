# GHL Marketplace App credentials (from marketplace.gohighlevel.com)
GHL_CLIENT_ID=your_client_id_here
GHL_CLIENT_SECRET=your_client_secret_here
GHL_SSO_KEY=your_sso_key_hex_here
GHL_REDIRECT_URI=https://your-ngrok-url.ngrok.io/oauth/callback
GHL_WEBHOOK_SECRET=your_webhook_signing_secret_or_leave_empty

# Server
PORT=3000
SESSION_SECRET=change_me_to_a_long_random_string
# Set to true when running behind ngrok/HTTPS (required for SameSite=None cookies in iframe)
HTTPS_ENABLED=true

# Database
DB_PATH=./data/app.db

# Anthropic API key (required — powers call analysis and KPI suggestions)
ANTHROPIC_API_KEY=sk-ant-...
