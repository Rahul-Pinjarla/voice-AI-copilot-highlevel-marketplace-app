{
  "name": "voice-ai-observability-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && npm run dev:server",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "seed": "tsx scripts/seed.ts",
    "demo:setup": "tsx scripts/setup-demo-agent.ts",
    "test:config-scenario": "tsx scripts/test-config-scenario.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --project client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.15.21",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.10"
  }
}
